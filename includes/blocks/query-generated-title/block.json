{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "title": "Query Loop Generated Title",
  "description": "Generates a title for a Query Loop block by using Taxonomies.",
  "textdomain": "abhainn",
  "name": "abhainn/query-generated-title",
  "icon": "heading",
  "category": "theme",
  "attributes":{
    "level": {
      "type": "number",
      "default": 2
    }
  },
  "supports": {
    "html": false,
    "typography": {
      "__experimentalFontFamily": true,
      "__experimentalFontStyle": true,
      "__experimentalFontWeight": true,
      "fontSize": true,
      "lineHeight": true,
      "textAlign": true
    }
  },
  "usesContext": [
    "query"
  ],
  "editorScript": "file:./index.js"
}
