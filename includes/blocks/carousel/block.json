{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "title": "Carousel",
  "description": "Display a range of content within a carousel.",
  "textdomain": "abhainn",
  "name": "abhainn/carousel",
  "icon": "slides",
  "category": "media",
  "keywords": [ "gallery", "images", "slider" ],
  "supports": {
    "align": true,
    "html": false
  },
  "attributes": {
    "hideScrollbar": {
      "default": false,
      "type": "boolean"
    },
    "sliderButtons": {
      "default": false,
      "type": "boolean"
    },
    "timer": {
      "default": 0,
      "type": "integer"
    }
  },
  "editorStyle": "file:./view.css",
  "editorScript": "file:./index.js",
  "viewScript": "file:./viewScript.js",
  "viewStyle": "file:./view.css"
}
