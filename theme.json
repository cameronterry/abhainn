{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "defaultPalette": false,
      "palette": [
        {
          "color": "#0C2C40",
          "name": "Primary",
          "slug": "primary"
        },
        {
          "color": "#FFFFFF",
          "name": "Primary Contrast",
          "slug": "primary-contrast"
        },
        {
          "color": "#345573",
          "name": "Secondary",
          "slug": "secondary"
        },
        {
          "color": "var(--wp--preset--color--primary-contrast)",
          "name": "Secondary Contrast",
          "slug": "secondary-contrast"
        },
        {
          "color": "#728EA6",
          "name": "Tertiary",
          "slug": "tertiary"
        },
        {
          "color": "#000000",
          "name": "Tertiary Contrast",
          "slug": "tertiary-contrast"
        },
        {
          "color": "#F2D091",
          "name": "Accent",
          "slug": "accent"
        },
        {
          "color": "#BF9F78",
          "name": "Accent (Dark)",
          "slug": "accent-dark"
        },
        {
          "color": "#000000",
          "name": "Text (default)",
          "slug": "text-default"
        },
        {
          "color": "var(--wp--preset--color--primary-contrast)",
          "name": "Background",
          "slug": "background"
        },
        {
          "color": "var(--wp--preset--color--primary-contrast)",
          "name": "Text (Dark)",
          "slug": "text-dark"
        },
        {
          "color": "#0C2C40",
          "name": "Background (Dark)",
          "slug": "background-dark"
        }
      ]
    },
    "layout": {
      "contentSize": "42.5rem",
      "wideSize": "80rem"
    },
    "spacing": {
      "padding": true
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "name": "Identity",
          "slug": "identity",
          "fontFamily": "'Cal Sans', sans-serif",
          "fontFace": [
            {
              "fontFamily": "Cal Sans",
              "fontStretch": "normal",
              "fontStyle": "normal",
              "fontWeight": "600",
              "src": [ "file:./dist/fonts/CalSans-Regular.woff2" ]
            }
          ]
        },
        {
          "name": "Primary",
          "slug": "primary",
          "fontFamily": "'InterVariable', sans-serif",
          "fontFace": [
            {
              "fontFamily": "InterVariable",
              "fontStretch": "normal",
              "fontStyle": "normal",
              "fontWeight": "100 900",
              "src": [ "file:./dist/fonts/InterVariable.woff2" ]
            },
            {
              "fontFamily": "InterVariable",
              "fontStretch": "normal",
              "fontStyle": "italic",
              "fontWeight": "100 900",
              "src": [ "file:./dist/fonts/InterVariable-Italic.woff2" ]
            }
          ]
        }
      ]
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "blocks": {
      "core/button": {
        "variations": {
          "outline": {
            "border": {
              "color": "var:preset|color|accent"
            },
            "color": {
              "text": "var:preset|color|accent"
            }
          }
        }
      },
      "core/site-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|identity"
        }
      }
    },
    "elements": {
      "button": {
        "border": {
          "radius": 0
        },
        "color": {
          "background": "var:preset|color|accent",
          "text": "var:preset|color|text-default"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|primary-contrast"
          }
        }
      },
      "h1": {
        "typography": {
          "fontFamily": "var:preset|font-family|identity"
        }
      }
    },
    "spacing": {
      "padding": {
        "bottom": 0,
        "left": "2rem",
        "right": "2rem",
        "top": 0
      }
    }
  },
  "templateParts": [
    {
      "area": "header",
      "name": "header-default",
      "title": "Header (Default)"
    },
    {
      "area": "footer",
      "name": "footer-default",
      "title": "Footer (Default)"
    }
  ]
}
