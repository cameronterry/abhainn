{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "42.5rem",
      "wideSize": "80rem"
    },
    "spacing": {
      "padding": true
    },
    "typography": {
      "defaultFontSizes": false,
      "fluid": true,
      "fontFamilies": [
        {
          "name": "Identity",
          "slug": "identity",
          "fontFamily": "'Cal Sans', sans-serif",
          "fontFace": [
            {
              "fontDisplay": "swap",
              "fontFamily": "Cal Sans",
              "fontStretch": "normal",
              "fontStyle": "normal",
              "fontWeight": "600",
              "src": [ "file:./dist/fonts/CalSans-Regular.woff2" ]
            }
          ]
        },
        {
          "name": "Primary",
          "slug": "primary",
          "fontFamily": "'InterVariable', sans-serif",
          "fontFace": [
            {
              "fontDisplay": "swap",
              "fontFamily": "InterVariable",
              "fontStretch": "normal",
              "fontStyle": "normal",
              "fontWeight": "100 900",
              "src": [ "file:./dist/fonts/InterVariable.woff2" ]
            },
            {
              "fontDisplay": "swap",
              "fontFamily": "InterVariable",
              "fontStretch": "normal",
              "fontStyle": "italic",
              "fontWeight": "100 900",
              "src": [ "file:./dist/fonts/InterVariable-Italic.woff2" ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "fluid": false,
          "name": "Small",
          "size": "0.875rem",
          "slug": "small"
        },
        {
          "fluid": {
            "max": "1.125rem",
            "min": "1rem"
          },
          "name": "Medium",
          "size": "1rem",
          "slug": "medium"
        },
        {
          "fluid": {
            "max": "1.375rem",
            "min": "1.125rem"
          },
          "name": "Large",
          "size": "1.38rem",
          "slug": "large"
        },
        {
          "fluid": {
            "max": "2rem",
            "min": "1.75rem"
          },
          "name": "Extra Large",
          "size": "1.75rem",
          "slug": "x-large"
        },
        {
          "fluid": {
            "max": "3rem",
            "min": "2.15rem"
          },
          "name": "Extra Extra Large",
          "size": "2.15rem",
          "slug": "xx-large"
        },
        {
          "slug": "super-large",
          "size": "4.5rem",
          "name": "Super Large",
          "fluid": {
            "min": "2.7rem",
            "max": "5rem"
          }
        }
      ]
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "blocks": {
      "core/button": {
        "variations": {
          "outline": {
            "border": {
              "color": "var:preset|color|accent"
            },
            "color": {
              "text": "var:preset|color|accent"
            }
          }
        }
      },
      "core/site-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|identity"
        }
      }
    },
    "elements": {
      "button": {
        "border": {
          "radius": "0"
        },
        "color": {
          "background": "var:preset|color|accent",
          "text": "var:preset|color|accent-contrast"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|primary",
            "text": "var:preset|color|primary-contrast"
          }
        }
      },
      "h1": {
        "typography": {
          "fontFamily": "var:preset|font-family|identity"
        }
      }
    },
    "spacing": {
      "padding": {
        "bottom": "0",
        "left": "2rem",
        "right": "2rem",
        "top": "0"
      }
    }
  },
  "templateParts": [
    {
      "area": "header",
      "name": "header-default",
      "title": "Header (Default)"
    },
    {
      "area": "footer",
      "name": "footer-default",
      "title": "Footer (Default)"
    }
  ]
}
